<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>Dreamstreaming.DiscordBot</AssemblyName>
    <RootNamespace>Dreamstreaming.DiscordBot</RootNamespace>

    <Version>1.2.6</Version>
    <AssemblyVersion>1.2.6.0</AssemblyVersion>
    <FileVersion>1.2.6.0</FileVersion>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

  </ItemGroup>

  <ItemGroup>

    <None Remove="web/config.html" />

    <EmbeddedResource Include="web/config.html">
      <LogicalName>Dreamstreaming.DiscordBot.Web.config.html</LogicalName>
    </EmbeddedResource>

  </ItemGroup>

</Project>